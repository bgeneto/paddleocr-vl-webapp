# =============================================================================
# PaddleOCR-VL Document Parser Configuration
# =============================================================================
# Copy this file to .env and customize as needed
# All values shown are defaults

# =============================================================================
# Streamlit Configuration
# =============================================================================
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
STREAMLIT_THEME_BASE=light

# Host port mapping (external port)
STREAMLIT_HOST_PORT=8505

# =============================================================================
# Application Configuration
# =============================================================================
APP_TITLE=PaddleOCR-VL Document Parser
APP_DESCRIPTION=Upload PDF or image files to convert them to Markdown using PaddleOCR-VL
# Maximum file size in MB
MAX_FILE_SIZE_MB=99
# Maximum number of pages to process for PDFs
MAX_PDF_PAGES=350
# Maximum parallel chunk workers (keep low - API may serialize requests internally)
# Higher values don't help if API processes one request at a time
MAX_PARALLEL_PAGES=2
# Maximum pages to show in preview tab (prevents browser slowdown with large documents)
MAX_PREVIEW_PAGES=10
# Pages per chunk sent to API - KEEP THIS SETTING BELOW 10!
# Higher = better GPU utilization (vLLM batches all pages in chunk together)
# Lower = less VRAM usage but worse GPU utilization
# Recommended: 5-10 (default 8, maximum 10)
PAGES_PER_CHUNK=2

# =============================================================================
# PaddleOCR-VL API Configuration
# =============================================================================
# API endpoint URL (default uses Docker service name)
PADDLEOCR_VL_API_URL=http://paddleocr-vl-api:8080/layout-parsing
# Request timeout in seconds (increase for large files)
API_TIMEOUT=300

# =============================================================================
# Processing Options (Default values for UI)
# =============================================================================
# Enable document orientation classification
USE_DOC_ORIENTATION_CLASSIFY=false
# Enable document unwarping for curved/distorted images.
# Stays off in quality-first too (UVDoc unwarping 500s the llama.cpp VLM).
USE_DOC_UNWARPING=false
# Enable layout detection (recommended for best results)
USE_LAYOUT_DETECTION=true
# Enable chart and diagram recognition.
# Stays off in quality-first too (enable from the sidebar when needed).
USE_CHART_RECOGNITION=false
# Prettify markdown output
PRETTIFY_MARKDOWN=true
# Insert HTML comments such as <!-- Page 2 --> between pages (RAG chunking).
# On by default. Turn off from the sidebar for a single concatenated document.
INCLUDE_PAGE_MARKERS=true
# Return visualization images (slower but useful for debugging)
VISUALIZE_RESULTS=false
# Master switch: false = speed-first (current defaults). true = quality-first
# pipeline (preprocessor, seal, figure OCR, high-recall layout,
# cross-page table/title reconstruction; chart recognition stays off).
# Recreate the API *and* Streamlit containers after changing this:
# docker compose up -d --force-recreate
# (vLLM stack: docker compose -f compose.vllm.yaml up -d --force-recreate)
OCR_QUALITY_FIRST=true

# =============================================================================
# Storage / Caching
# =============================================================================
# Directory where processed results (markdown + ZIP) are persisted and cached,
# keyed by file SHA-256 and processing-options fingerprint. Re-uploading a
# byte-identical file with the same options is served instantly from disk.
# In Docker this maps to the ./data bind mount (see compose.yaml).
# For local (non-Docker) development, leave unset to default to <repo>/data.
DATA_DIR=/app/data
# Delete cached result folders (meta.json, result.md, result.zip, pages/*.json)
# older than this many days. The disk cache is for instant re-uploads only and
# must not grow forever. Recreate the Streamlit container after changing this.
# Set to 0 to disable automatic cleanup.
DATA_CACHE_RETENTION_DAYS=45
# Numeric uid/gid the Streamlit container runs as. Must match the owner of the
# ./data and ./logs bind mounts so the result cache can be written. Use your
# host values from `id -u` and `id -g` (do not name these UID — bash UID is
# read-only). Recreate Streamlit after changing:
#   docker compose up -d --build --force-recreate streamlit-app
APP_UID=1000
APP_GID=1000

# =============================================================================
# Docker/VLM Backend Configuration
# =============================================================================
# VLM inference backend for compose.vllm.yaml only: vllm or fastdeploy
VLM_BACKEND=vllm
# Docker image tag suffix (use 'latest' for online, 'latest-offline' for offline)
API_IMAGE_TAG_SUFFIX=latest-nvidia-gpu-offline
VLM_IMAGE_TAG_SUFFIX=latest-nvidia-gpu-offline
# GPU device ID to use (0, 1, etc.)
GPU_DEVICE_ID=0

# NOTE: vLLM memory settings are configured in vllm_config.yaml (not here)

# =============================================================================
# llama.cpp stack (default compose.yaml)
# =============================================================================
# Q8_0 decoder (mradermacher) + official F16 mmproj (PaddlePaddle).
# GGUFs are stored on the host at ./models/llamacpp and reused on every start.
# These do NOT reuse MAX_PARALLEL_PAGES / PAGES_PER_CHUNK (those stay conservative for vLLM).
# Streamlit maps LLAMA_MAX_PARALLEL_PAGES / LLAMA_PAGES_PER_CHUNK onto the same app.py knobs.
# Pin to a published GHCR build (floating :server-cuda moves). b10689 is the latest
# CUDA server image as of 2026-08-30; llama.cpp #25233 (UTF-8 sanitizer) never merged.
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b10689
LLAMA_HF_REPO=mradermacher/PaddleOCR-VL-1.6-GGUF
LLAMA_HF_FILE=PaddleOCR-VL-1.6.Q8_0.gguf
LLAMA_MMPROJ_FILE=PaddleOCR-VL-1.6-GGUF-mmproj.gguf
LLAMA_MMPROJ_URL=https://huggingface.co/PaddlePaddle/PaddleOCR-VL-1.6-GGUF/resolve/main/PaddleOCR-VL-1.6-GGUF-mmproj.gguf
# Optional Hugging Face token (https://huggingface.co/settings/tokens) — read access.
# Authenticated downloads avoid anonymous rate limits and are usually faster.
HF_TOKEN=
# Desired tokens per llama-server slot (not the total). Total n_ctx =
# min(LLAMA_CTX_SIZE * LLAMA_N_PARALLEL, LLAMA_CTX_MAX). Default 8*8192=65536.
LLAMA_CTX_SIZE=8192
# Cap on total llama-server --ctx-size (KV cache). Raise if you want more slots
# without shrinking n_ctx_slot.
LLAMA_CTX_MAX=131072
# Concurrent Streamlit API chunk workers (llama stack).
# Keep this modest: overlapping layout+VLM jobs contend on one GPU.
LLAMA_MAX_PARALLEL_PAGES=2
# Pages per API request (llama stack). Higher = fatter paddlex batches.
LLAMA_PAGES_PER_CHUNK=32
# llama-server slots and paddlex VLM max_concurrency (crops per page, not PDF pages)
LLAMA_N_PARALLEL=8
LLAMA_N_GPU_LAYERS=99
# Physical llama-server batch for prompt/vision prefill (default in llama.cpp is 512)
LLAMA_UBATCH_SIZE=2048
# Unload the VLM from VRAM after this many idle seconds (llama-server --sleep-idle-seconds).
# Next OCR request reloads it. -1 disables. Recreate paddleocr-vlm-server after changing.
LLAMA_SLEEP_IDLE_SECONDS=60
# Stop paddlex after this many idle seconds so PP-DocLayoutV3 (~4 GiB) leaves VRAM.
# PaddleX has no --sleep-idle-seconds; the compose wrapper kills the process (the
# only way Paddle returns memory to nvidia-smi). Next OCR restarts it (~20-60s).
# GET /health does not reset the timer. 0 = stop as soon as the last request
# finishes. -1 disables. Recreate paddleocr-vl-api after changing.
PADDLEX_SLEEP_IDLE_SECONDS=60
# KV cache dtype is not set here: q4_0 when OCR_QUALITY_FIRST=false, q8_0 when true.
# Recreate paddleocr-vlm-server after changing OCR_QUALITY_FIRST.

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
